+++ b/android/src/main/res/layout/exo_player_view_texture.xml
@@ -0,0 +1,17 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  YancoTV patch (M4R.Audit.4) — a Media3 PlayerView configured with
+  app:surface_type="texture_view". Inflated from ExoPlayerView.kt so the
+  internal surface is a TextureView instead of the Media3 default
+  SurfaceView. Needed for the persistent-player / transparent-modal
+  architecture — SurfaceView composes in a separate window that
+  transparent JS overlays can't paint over.
+
+  This resource is added by patches/react-native-video@6.19.1.patch.
+-->
+<androidx.media3.ui.PlayerView
+    xmlns:android="http://schemas.android.com/apk/res-android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    app:surface_type="texture_view" />
