{
  "name": "yancotv",
  "version": "0.1.0",
  "description": "Custom IPTV media application",
  "private": true,
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p tsconfig.main.json && pnpm build:preload && wait-on http://localhost:5173 && electron .",
    "build": "tsc -p tsconfig.main.json && pnpm build:preload && vite build",
    "build:main": "tsc -p tsconfig.main.json && pnpm build:preload",
    "build:preload": "esbuild src/main/preload.ts --bundle --platform=node --outfile=dist/main/main/preload.js --external:electron --format=cjs",
    "build:renderer": "vite build",
    "package": "pnpm build && electron-builder",
    "test": "node scripts/run-tests.js",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-sqlite3": "^12.9.0",
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.0",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.6.16",
    "motion": "^12.38.0",
    "mpegts.js": "^1.8.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@tanstack/react-query": "^5.65.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^41.2.0",
    "electron-builder": "^25.1.8",
    "electron-playwright-helpers": "^2.1.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.3",
    "react-virtuoso": "^4.12.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.3",
    "zustand": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "ffmpeg-static"
    ]
  }
}
