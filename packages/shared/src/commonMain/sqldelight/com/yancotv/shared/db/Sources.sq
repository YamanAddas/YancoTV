-- IPTV sources (M3U URLs, local files, Xtream/Stalker credentials).
-- Mirrors src/main/services/migrations/001 + 004 + 007 + 014 consolidated.

CREATE TABLE sources (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    type TEXT NOT NULL CHECK(type IN ('m3u_url', 'm3u_file', 'xtream', 'stalker')),
    url TEXT,
    file_path TEXT,
    username_encrypted BLOB,
    password_encrypted BLOB,
    mac_address_encrypted BLOB,
    epg_url TEXT,
    user_agent TEXT,
    -- Stage 2.3 — per-source HTTP Referer override for providers that
    -- gate playback on the header. NULL = no override (no Referer sent).
    referer TEXT,
    last_synced INTEGER,
    last_sync_error TEXT,
    is_active INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    priority INTEGER NOT NULL DEFAULT 0,
    channel_count INTEGER NOT NULL DEFAULT 0,
    auto_sync_interval INTEGER NOT NULL DEFAULT 0,
    -- Stage 2.4 — multi-EPG merge priority. Higher wins when two
    -- sources cover the same tvg_id. Default 0 keeps single-source
    -- behaviour unchanged.
    epg_priority INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX idx_sources_priority ON sources(priority ASC);
CREATE INDEX idx_sources_epg_priority ON sources(epg_priority DESC);

selectAll:
SELECT * FROM sources ORDER BY priority ASC, created_at ASC;

selectById:
SELECT * FROM sources WHERE id = ?;

selectActive:
SELECT * FROM sources WHERE is_active = 1 ORDER BY priority ASC;

insert:
INSERT INTO sources (
    id, name, type, url, file_path,
    username_encrypted, password_encrypted, mac_address_encrypted,
    epg_url, user_agent, referer, last_synced, last_sync_error,
    is_active, priority, channel_count, auto_sync_interval,
    epg_priority,
    created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSyncResult:
UPDATE sources
SET last_synced = ?, last_sync_error = ?, channel_count = ?, updated_at = ?
WHERE id = ?;

setActive:
UPDATE sources SET is_active = ?, updated_at = ? WHERE id = ?;

updateFields:
UPDATE sources
SET name = ?,
    url = ?,
    username_encrypted = ?,
    password_encrypted = ?,
    mac_address_encrypted = ?,
    epg_url = ?,
    user_agent = ?,
    referer = ?,
    auto_sync_interval = ?,
    updated_at = ?
WHERE id = ?;

setPriority:
UPDATE sources SET priority = ?, updated_at = ? WHERE id = ?;

-- Stage 2.4 — EPG merge priority setter for the multi-EPG conflict UI.
-- Note this is independent of `priority` (which orders sources in the
-- shell rail); two different orderings serve different UX purposes.
setEpgPriority:
UPDATE sources SET epg_priority = ?, updated_at = ? WHERE id = ?;

-- Updates `epg_url` without touching credentials. Used to adopt an EPG URL
-- discovered during sync (the M3U `#EXTM3U url-tvg=`/`x-tvg-url=` header, or
-- the derived Xtream `xmltv.php` endpoint) when the user never provided one.
setEpgUrl:
UPDATE sources SET epg_url = ?, updated_at = ? WHERE id = ?;

deleteById:
DELETE FROM sources WHERE id = ?;
