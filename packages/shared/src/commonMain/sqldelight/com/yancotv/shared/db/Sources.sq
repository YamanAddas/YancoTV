-- IPTV sources (M3U URLs, local files, Xtream/Stalker credentials).
-- Mirrors src/main/services/migrations/001 + 004 + 007 + 014 consolidated.

CREATE TABLE sources (
    id TEXT PRIMARY KEY NOT NULL,
    name TEXT NOT NULL,
    type TEXT NOT NULL CHECK(type IN ('m3u_url', 'm3u_file', 'xtream', 'stalker')),
    url TEXT,
    file_path TEXT,
    username_encrypted BLOB,
    password_encrypted BLOB,
    mac_address_encrypted BLOB,
    epg_url TEXT,
    user_agent TEXT,
    -- Stage 2.3 — per-source HTTP Referer override for providers that
    -- gate playback on the header. NULL = no override (no Referer sent).
    referer TEXT,
    last_synced INTEGER,
    last_sync_error TEXT,
    is_active INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    priority INTEGER NOT NULL DEFAULT 0,
    channel_count INTEGER NOT NULL DEFAULT 0,
    auto_sync_interval INTEGER NOT NULL DEFAULT 0,  -- ms; 0 means "use the default" (MB-363; read by SyncOnStartDecision)
    -- Stage 2.4 — multi-EPG merge priority. Higher wins when two
    -- sources cover the same tvg_id. Default 0 keeps single-source
    -- behaviour unchanged.
    epg_priority INTEGER NOT NULL DEFAULT 0,
    -- v9 → v10 (MK.18.x): when 1, the Android shell triggers a
    -- background refresh for this source the moment MainActivity is
    -- created. Default 0 = opt-in only. Keyed per-source so the user
    -- can pick which catalogs are stable enough to warm-resync without
    -- their input.
    auto_sync_on_start INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    -- v11 → v12 (MK.30.3): when the provider account behind this source
    -- stops working, in ms since epoch. NULL = unknown, which is the
    -- permanent state for m3u_url / m3u_file (a playlist URL carries no
    -- account metadata) and the state for an xtream source that hasn't
    -- synced since the column was added.
    --
    -- Captured from the Xtream `player_api.php` handshake, whose
    -- `user_info.exp_date` is Unix *seconds* as a string — converted on the
    -- way in so this column follows the all-timestamps-are-ms rule.
    -- Xtream also uses NULL/absent exp_date to mean "never expires", which
    -- is indistinguishable here from "not yet known"; the UI treats both as
    -- "no expiry to show" rather than guessing.
    expires_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX idx_sources_priority ON sources(priority ASC);
CREATE INDEX idx_sources_epg_priority ON sources(epg_priority DESC);

selectAll:
SELECT * FROM sources ORDER BY priority ASC, created_at ASC;

selectById:
SELECT * FROM sources WHERE id = ?;

selectActive:
SELECT * FROM sources WHERE is_active = 1 ORDER BY priority ASC;

insert:
INSERT INTO sources (
    id, name, type, url, file_path,
    username_encrypted, password_encrypted, mac_address_encrypted,
    epg_url, user_agent, referer, last_synced, last_sync_error,
    is_active, priority, channel_count, auto_sync_interval,
    epg_priority, auto_sync_on_start,
    created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSyncResult:
UPDATE sources
SET last_synced = ?, last_sync_error = ?, channel_count = ?, updated_at = ?
WHERE id = ?;

setActive:
UPDATE sources SET is_active = ?, updated_at = ? WHERE id = ?;

updateFields:
UPDATE sources
SET name = ?,
    url = ?,
    username_encrypted = ?,
    password_encrypted = ?,
    mac_address_encrypted = ?,
    epg_url = ?,
    user_agent = ?,
    referer = ?,
    auto_sync_interval = ?,
    updated_at = ?
WHERE id = ?;

-- v11 → v12 (MK.30.3): account-expiry setter, written from the Xtream
-- handshake during sync.
--
-- Deliberately NOT folded into `updateSyncResult`: that runs on the failure
-- path too, where no expiry is available, so it would clobber a known expiry
-- with NULL every time a sync errored. A stale expiry is strictly better
-- information than none, so only a successful handshake writes here.
setExpiresAt:
UPDATE sources SET expires_at = ?, updated_at = ? WHERE id = ?;

setPriority:
UPDATE sources SET priority = ?, updated_at = ? WHERE id = ?;

-- Stage 2.4 — EPG merge priority setter for the multi-EPG conflict UI.
-- Note this is independent of `priority` (which orders sources in the
-- shell rail); two different orderings serve different UX purposes.
setEpgPriority:
UPDATE sources SET epg_priority = ?, updated_at = ? WHERE id = ?;

-- Updates `epg_url` without touching credentials. Used to adopt an EPG URL
-- discovered during sync (the M3U `#EXTM3U url-tvg=`/`x-tvg-url=` header, or
-- the derived Xtream `xmltv.php` endpoint) when the user never provided one.
setEpgUrl:
UPDATE sources SET epg_url = ?, updated_at = ? WHERE id = ?;

-- v9 → v10: per-source auto-sync-on-app-start setter, used by the
-- Settings → Sources → detail toggle.
setAutoSyncOnStart:
UPDATE sources SET auto_sync_on_start = ?, updated_at = ? WHERE id = ?;

-- v9 → v10: list of sources opted into the on-app-start auto-sync.
-- Read by the Android shell once at MainActivity creation.
selectAutoSyncOnStart:
SELECT * FROM sources WHERE auto_sync_on_start = 1 AND is_active = 1;

deleteById:
DELETE FROM sources WHERE id = ?;
