-- In-flight + completed recording rows. Created by the recording
-- foreground service when a [recording_schedules] entry fires (or a
-- manual record-now action runs); updated as the recording progresses.
-- Format is set at firing time based on the source stream type.
CREATE TABLE recordings (
    id TEXT PRIMARY KEY NOT NULL,
    content_id TEXT,
    title TEXT NOT NULL,
    stream_url TEXT NOT NULL,
    file_path TEXT NOT NULL,
    status TEXT NOT NULL CHECK(status IN ('recording', 'completed', 'failed', 'cancelled')),
    started_at INTEGER NOT NULL,    -- ms since epoch (actual fire time)
    ended_at INTEGER,               -- ms since epoch
    duration_seconds INTEGER,       -- wall-clock duration (fire→stop), seconds. NOT media duration —
                                    -- the actual broadcast/file duration depends on codec/bitrate
                                    -- and is not derivable from this. If a future feature needs
                                    -- media duration (e.g. resume-on-playback), read it from the
                                    -- file via ExoPlayer metadata at playback time.
    file_size_bytes INTEGER,
    error TEXT,
    -- 'hls' / 'mpeg_ts' / NULL. NULL on rows created before Stage 2.1
    -- migration; treated as 'unknown' by the recordings browser. New
    -- rows always set this.
    format TEXT
);

CREATE INDEX idx_recordings_status ON recordings(status);
CREATE INDEX idx_recordings_started_at ON recordings(started_at DESC);

selectAll:
SELECT * FROM recordings ORDER BY started_at DESC;

selectByStatus:
SELECT * FROM recordings WHERE status = ? ORDER BY started_at DESC;

selectById:
SELECT * FROM recordings WHERE id = ?;

insert:
INSERT INTO recordings
    (id, content_id, title, stream_url, file_path, status,
     started_at, ended_at, duration_seconds, file_size_bytes, error, format)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateStatus:
UPDATE recordings
SET status = ?, ended_at = ?, duration_seconds = ?, file_size_bytes = ?, error = ?
WHERE id = ?;

deleteById:
DELETE FROM recordings WHERE id = ?;
