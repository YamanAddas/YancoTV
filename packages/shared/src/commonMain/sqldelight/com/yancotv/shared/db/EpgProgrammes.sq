CREATE TABLE epg_programmes (
    id TEXT PRIMARY KEY NOT NULL,
    source_id TEXT REFERENCES sources(id) ON DELETE CASCADE,
    channel_tvg_id TEXT NOT NULL,
    title TEXT NOT NULL,
    description TEXT,
    start_time INTEGER NOT NULL, -- XMLTV epoch SECONDS (NOT ms — matches xmltv.dtd)
    end_time INTEGER NOT NULL,   -- XMLTV epoch SECONDS (NOT ms — matches xmltv.dtd)
    category TEXT,
    icon_url TEXT
);

CREATE INDEX idx_epg_channel_time ON epg_programmes(channel_tvg_id, start_time);
CREATE INDEX idx_epg_channel_end_start ON epg_programmes(channel_tvg_id, end_time, start_time);
CREATE INDEX idx_epg_time_window ON epg_programmes(end_time, start_time);
CREATE INDEX idx_epg_source ON epg_programmes(source_id);
CREATE INDEX idx_epg_end_time ON epg_programmes(end_time);

-- MK.15.7 — multi-EPG conflict resolution. Queries that read programmes
-- LEFT JOIN sources and ORDER BY epg_priority DESC so the highest-
-- priority source's row wins when two sources cover the same tvg_id.
-- `SELECT p.*` keeps SQLDelight's row mapper unchanged; the JOIN is
-- only there for the ORDER BY. Single-source installs (the common
-- case) are unaffected because every row's priority resolves to the
-- same value. COALESCE handles orphan programmes whose source row
-- was already cascade-deleted but whose programmes haven't been swept
-- yet — they sort at priority 0 (lowest).

nowForChannel:
SELECT p.* FROM epg_programmes p
LEFT JOIN sources s ON s.id = p.source_id
WHERE p.channel_tvg_id = ? AND p.start_time <= ? AND p.end_time > ?
ORDER BY COALESCE(s.epg_priority, 0) DESC
LIMIT 1;

-- MK.EPG.G — same NOT EXISTS dedup as `forChannelRange`. Without it,
-- two equal-priority sources covering the same `now` slot would both
-- claim rows 1+2 of the LIMIT 2 — caller would see "now" + "now"
-- duplicate and lose "next" entirely. With dedup, LIMIT 2 returns
-- the deduped now + next pair the caller expects.
nowNextForChannel:
SELECT p.* FROM epg_programmes p
LEFT JOIN sources s ON s.id = p.source_id
WHERE p.channel_tvg_id = ? AND p.end_time > ?
  AND NOT EXISTS (
    SELECT 1 FROM epg_programmes p2
    LEFT JOIN sources s2 ON s2.id = p2.source_id
    WHERE p2.channel_tvg_id = p.channel_tvg_id
      AND p2.start_time = p.start_time
      AND p2.id != p.id
      AND (
        COALESCE(s2.epg_priority, 0) > COALESCE(s.epg_priority, 0)
        OR (COALESCE(s2.epg_priority, 0) = COALESCE(s.epg_priority, 0) AND p2.id < p.id)
      )
  )
ORDER BY COALESCE(s.epg_priority, 0) DESC, p.start_time ASC
LIMIT 2;

guideWindow:
SELECT p.* FROM epg_programmes p
LEFT JOIN sources s ON s.id = p.source_id
WHERE p.end_time > ? AND p.start_time < ?
ORDER BY p.channel_tvg_id, COALESCE(s.epg_priority, 0) DESC, p.start_time;

-- MK.14.6 — find future programmes on a channel matching a title (case
-- sensitive; titles are EPG-canonical and the binding key is exact-match
-- on the snapshot the user long-pressed). [now] is the floor;
-- [windowEnd] caps the lookahead (typically now + 7 days).
futureByChannelAndTitle:
SELECT p.* FROM epg_programmes p
LEFT JOIN sources s ON s.id = p.source_id
WHERE p.channel_tvg_id = ?
  AND p.title = ?
  AND p.start_time >= ?
  AND p.start_time < ?
ORDER BY COALESCE(s.epg_priority, 0) DESC, p.start_time ASC;

-- MK.EPG.G — multi-source dedup. When 2+ sources cover the same
-- (channel_tvg_id, start_time) (common when the user has both an
-- Xtream provider's xmltv.php AND a global epg.xz wired up), the
-- pre-fix query returned every row, so a Guide cell rendered the
-- same programme twice from different sources. The NOT EXISTS clause
-- keeps only the highest-priority row per (channel, start_time);
-- ties break on smallest `id` so the choice is deterministic across
-- repeated queries (id format `channelId|startTime|sourceKey` makes
-- this effectively "smallest sourceKey wins" for ties).
--
-- Single-source DBs see no behaviour change — the inner subquery
-- evaluates to false for every row (no other p2 with same
-- (channel, start_time) and `id != p.id` exists). Cost there is one
-- empty index seek per outer row via `idx_epg_channel_time`, ~µs.
forChannelRange:
SELECT p.* FROM epg_programmes p
LEFT JOIN sources s ON s.id = p.source_id
WHERE p.channel_tvg_id = ? AND p.end_time > ? AND p.start_time < ?
  AND NOT EXISTS (
    SELECT 1 FROM epg_programmes p2
    LEFT JOIN sources s2 ON s2.id = p2.source_id
    WHERE p2.channel_tvg_id = p.channel_tvg_id
      AND p2.start_time = p.start_time
      AND p2.id != p.id
      AND (
        COALESCE(s2.epg_priority, 0) > COALESCE(s.epg_priority, 0)
        OR (COALESCE(s2.epg_priority, 0) = COALESCE(s.epg_priority, 0) AND p2.id < p.id)
      )
  )
ORDER BY COALESCE(s.epg_priority, 0) DESC, p.start_time;

-- MK.EPG.F — batched programme fetch for the Guide grid. The per-channel
-- `forChannelRange` is fine for one-off lookups (now/next, catchup) but
-- `EpgRepository.getGuideData` previously called it once per channel in
-- a 100-row page → 101 queries per Guide page. Replacing that loop with
-- a single `IN ?` query lets the planner do one index seek per channel
-- using `idx_epg_channel_end_start` and lets Kotlin do the grouping
-- in O(N) over the result list.
--
-- Order matches `forChannelRange` per channel — channel_tvg_id first
-- so the result is already in groupBy-friendly runs, then priority
-- DESC then start_time ASC inside each channel (so high-priority
-- source rows come first when MK.15.7 multi-EPG is configured).
-- Caller must chunk to stay under SQLITE_MAX_VARIABLE_NUMBER (999);
-- `EpgRepository.GUIDE_FETCH_CHUNK` enforces 500.
--
-- MK.EPG.G — same NOT EXISTS dedup as `forChannelRange` (see comment
-- above). The Guide grid is the dedup's load-bearing caller — without
-- it a multi-EPG user sees every programme rendered twice.
forChannelsRange:
SELECT p.* FROM epg_programmes p
LEFT JOIN sources s ON s.id = p.source_id
WHERE p.channel_tvg_id IN ? AND p.end_time > ? AND p.start_time < ?
  AND NOT EXISTS (
    SELECT 1 FROM epg_programmes p2
    LEFT JOIN sources s2 ON s2.id = p2.source_id
    WHERE p2.channel_tvg_id = p.channel_tvg_id
      AND p2.start_time = p.start_time
      AND p2.id != p.id
      AND (
        COALESCE(s2.epg_priority, 0) > COALESCE(s.epg_priority, 0)
        OR (COALESCE(s2.epg_priority, 0) = COALESCE(s.epg_priority, 0) AND p2.id < p.id)
      )
  )
ORDER BY p.channel_tvg_id, COALESCE(s.epg_priority, 0) DESC, p.start_time;

insert:
INSERT INTO epg_programmes (id, source_id, channel_tvg_id, title, description, start_time, end_time, category, icon_url)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

upsert:
INSERT OR REPLACE INTO epg_programmes (id, source_id, channel_tvg_id, title, description, start_time, end_time, category, icon_url)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM epg_programmes;

deleteBySource:
DELETE FROM epg_programmes WHERE source_id = ?;

deleteStale:
DELETE FROM epg_programmes WHERE end_time < ?;

countAll:
SELECT COUNT(*) FROM epg_programmes;

countChannels:
SELECT COUNT(DISTINCT channel_tvg_id) FROM epg_programmes;
