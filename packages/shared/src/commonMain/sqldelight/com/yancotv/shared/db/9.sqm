-- v9 → v10: per-source "auto-sync on app start" flag.
--
-- Default 0 (off) keeps behaviour unchanged for every existing source.
-- The user opts a source in via Settings → Sources → (source) →
-- "Auto-sync on app start". The Android shell reads sources where
-- `auto_sync_on_start = 1` once at MainActivity creation and kicks off
-- a SourceSyncCoordinator.start() for each — the same coordinator the
-- manual Sync button uses, so the user-visible sync banner appears
-- normally.
ALTER TABLE sources ADD COLUMN auto_sync_on_start INTEGER NOT NULL DEFAULT 0;
