CREATE TABLE reminders (
    id TEXT PRIMARY KEY NOT NULL,
    programme_id TEXT NOT NULL,
    channel_tvg_id TEXT NOT NULL,
    title TEXT NOT NULL,
    start_time INTEGER NOT NULL,
    end_time INTEGER NOT NULL,
    lead_seconds INTEGER NOT NULL DEFAULT 0,
    fire_at INTEGER NOT NULL,
    fired INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

CREATE INDEX idx_reminders_fire_at_unfired
    ON reminders(fire_at) WHERE fired = 0;

CREATE INDEX idx_reminders_programme ON reminders(programme_id);

selectUnfiredDue:
SELECT * FROM reminders WHERE fired = 0 AND fire_at <= ? ORDER BY fire_at;

selectAll:
SELECT * FROM reminders ORDER BY start_time;

selectAllUnfired:
SELECT * FROM reminders WHERE fired = 0 ORDER BY fire_at;

selectById:
SELECT * FROM reminders WHERE id = ?;

selectByProgrammeId:
SELECT * FROM reminders WHERE programme_id = ? LIMIT 1;

insert:
INSERT INTO reminders
    (id, programme_id, channel_tvg_id, title, start_time, end_time, lead_seconds, fire_at, fired, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markFired:
UPDATE reminders SET fired = 1 WHERE id = ?;

deleteById:
DELETE FROM reminders WHERE id = ?;

deleteByProgrammeId:
DELETE FROM reminders WHERE programme_id = ?;

deleteStale:
DELETE FROM reminders WHERE end_time < ?;
