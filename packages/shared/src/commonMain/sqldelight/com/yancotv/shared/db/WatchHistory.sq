CREATE TABLE watch_history (
    id TEXT PRIMARY KEY NOT NULL,
    content_id TEXT NOT NULL REFERENCES content(id) ON DELETE CASCADE,
    episode_id TEXT REFERENCES episodes(id),
    position_seconds INTEGER NOT NULL DEFAULT 0, -- media offset, seconds
    duration_seconds INTEGER,                    -- media duration, seconds
    watched_at INTEGER NOT NULL                  -- wall clock, ms since epoch
);

CREATE INDEX idx_watch_history_content ON watch_history(content_id);
CREATE INDEX idx_watch_history_watched_at ON watch_history(watched_at DESC);
-- MK.28 / audit catch — selectByEpisode + selectByEpisodeIds + the
-- episode_id FK integrity check all filter on `episode_id` with no
-- covering index, so series-detail screens (which call positionForEpisode
-- per visible tile) full-scan watch_history on every render. Partial
-- index keeps the size tight by skipping content-level rows.
CREATE INDEX idx_watch_history_episode ON watch_history(episode_id) WHERE episode_id IS NOT NULL;

selectRecent:
SELECT * FROM watch_history ORDER BY watched_at DESC LIMIT ?;

-- Audit catch — `recent()` / `recentFlow()` previously did a SELECT *
-- on watch_history then issued one selectById per distinct content_id
-- (N+1, ~30 PK lookups per Home-rail emit; recentFlow fires on every
-- persistResumePoint upsert). JOIN it once at the DB so the Flow does
-- one SELECT and the row mapper has every field it needs. Same shape
-- as how Favorites + EPG already JOIN.
selectRecentWithContent:
SELECT
    wh.id AS wh_id,
    wh.content_id AS wh_content_id,
    wh.episode_id AS wh_episode_id,
    wh.position_seconds AS wh_position_seconds,
    wh.duration_seconds AS wh_duration_seconds,
    wh.watched_at AS wh_watched_at,
    c.id AS c_id,
    c.source_id AS c_source_id,
    c.type AS c_type,
    c.title AS c_title,
    c.clean_title AS c_clean_title,
    c.group_name AS c_group_name,
    c.stream_url AS c_stream_url,
    c.logo_url AS c_logo_url,
    c.tvg_id AS c_tvg_id,
    c.metadata_json AS c_metadata_json,
    c.sort_order AS c_sort_order,
    c.created_at AS c_created_at,
    c.name_override AS c_name_override,
    c.logo_override AS c_logo_override
FROM watch_history wh
JOIN content c ON c.id = wh.content_id
ORDER BY wh.watched_at DESC
LIMIT ?;

selectByContent:
SELECT * FROM watch_history WHERE content_id = ? ORDER BY watched_at DESC;

selectByEpisode:
SELECT * FROM watch_history WHERE episode_id = ? ORDER BY watched_at DESC LIMIT 1;

-- MK.28.1 — batched lookup for tile-level progress indicators across the
-- whole app (browse coverflow, favorites rows, search results, episode
-- lists). The caller passes the visible-window IDs only; the row count is
-- bounded by the visible window, not the catalogue. DESC order lets the
-- repo pick the most-recent row per content/episode group with .first().
selectByContentIds:
SELECT * FROM watch_history WHERE content_id IN ? ORDER BY watched_at DESC;

selectByEpisodeIds:
SELECT * FROM watch_history WHERE episode_id IN ? ORDER BY watched_at DESC;

-- MB-374 — full-table progress feed for the browse coverflow. watch_history
-- holds one row per title the user has actually watched (a small table), so
-- the coverflow subscribes to the whole thing and builds its tile-progress
-- map in memory rather than passing an IN-list of every loaded tile. That
-- decouples the browse item cap from SQLite's bind-variable limit (999 on
-- API <= 30): a large category can now page past 1000 items without this
-- lookup overflowing its `content_id IN (...)` list. DESC order lets the repo
-- pick the most-recent row per content group with .first().
selectAllProgress:
SELECT * FROM watch_history ORDER BY watched_at DESC;

upsert:
INSERT OR REPLACE INTO watch_history (id, content_id, episode_id, position_seconds, duration_seconds, watched_at)
VALUES (?, ?, ?, ?, ?, ?);

deleteByContent:
DELETE FROM watch_history WHERE content_id = ?;

clearAll:
DELETE FROM watch_history;
