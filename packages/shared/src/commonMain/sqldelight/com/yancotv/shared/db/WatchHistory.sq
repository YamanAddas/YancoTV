CREATE TABLE watch_history (
    id TEXT PRIMARY KEY NOT NULL,
    content_id TEXT NOT NULL REFERENCES content(id) ON DELETE CASCADE,
    episode_id TEXT REFERENCES episodes(id),
    position_seconds INTEGER NOT NULL DEFAULT 0, -- media offset, seconds
    duration_seconds INTEGER,                    -- media duration, seconds
    watched_at INTEGER NOT NULL                  -- wall clock, ms since epoch
);

CREATE INDEX idx_watch_history_content ON watch_history(content_id);
CREATE INDEX idx_watch_history_watched_at ON watch_history(watched_at DESC);

selectRecent:
SELECT * FROM watch_history ORDER BY watched_at DESC LIMIT ?;

selectByContent:
SELECT * FROM watch_history WHERE content_id = ? ORDER BY watched_at DESC;

upsert:
INSERT OR REPLACE INTO watch_history (id, content_id, episode_id, position_seconds, duration_seconds, watched_at)
VALUES (?, ?, ?, ?, ?, ?);

deleteByContent:
DELETE FROM watch_history WHERE content_id = ?;

clearAll:
DELETE FROM watch_history;
