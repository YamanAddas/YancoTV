-- Channels, movies, series entries. Mirrors migrations 001 + 003.
-- FTS4 (not FTS5) because Android's bundled SQLite doesn't ship FTS5
-- on every device/API level.

CREATE TABLE content (
    id TEXT PRIMARY KEY NOT NULL,
    source_id TEXT NOT NULL REFERENCES sources(id) ON DELETE CASCADE,
    type TEXT NOT NULL CHECK(type IN ('live', 'movie', 'series')),
    title TEXT NOT NULL,
    clean_title TEXT,
    group_name TEXT,
    stream_url TEXT NOT NULL,
    logo_url TEXT,
    tvg_id TEXT,
    metadata_json TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL
);

CREATE INDEX idx_content_source ON content(source_id);
CREATE INDEX idx_content_type ON content(type);
CREATE INDEX idx_content_group ON content(group_name);
CREATE INDEX idx_content_clean_title ON content(clean_title);
CREATE INDEX idx_content_sort_order ON content(source_id, type, sort_order);

-- unicode61 + remove_diacritics lets non-Latin titles (Arabic, Cyrillic,
-- accented Latin) match without requiring the user to type diacritics.
-- Default ASCII tokenizer would silently drop these into one opaque bucket.
-- unicode61 splits non-Latin scripts correctly (Arabic, Cyrillic, accented
-- Latin). FTS4's tokenize argument is a single token, so the parameter-style
-- form "unicode61 remove_diacritics=1" is rejected by some SQLite builds as
-- an unknown tokenizer. We drop the diacritics flag here and handle case-
-- folding/diacritic stripping in clean_title at write time instead.
CREATE VIRTUAL TABLE content_fts USING fts4(
    content_id,
    title,
    clean_title,
    group_name,
    tokenize=unicode61
);

CREATE TRIGGER content_ai AFTER INSERT ON content BEGIN
    INSERT INTO content_fts (content_id, title, clean_title, group_name)
    VALUES (new.id, new.title, new.clean_title, new.group_name);
END;

-- `content_ad` (per-row FTS delete trigger) was removed in MK.6.d: it made a
-- whole-catalog resync take minutes. FTS4's virtual table has no index on
-- `content_id`, so each trigger fire scanned the entire FTS → O(N²) for an
-- N-row wipe (50k rows ≈ 2.5B scans). It also wedged the thread enough to
-- make Cancel unresponsive. FTS is now cleared explicitly in a single bulk
-- statement (`deleteFtsBySource`) before the content DELETE.
--
-- `content_au` was also removed — we never do row UPDATEs today; rows are
-- only inserted (via bulk writes) or wiped (via `deleteBySource`). If we
-- ever add an UPDATE path it needs matching manual FTS handling.

selectById:
SELECT * FROM content WHERE id = ?;

selectByType:
SELECT * FROM content
WHERE type = ?
ORDER BY source_id, sort_order;

selectByTypeAndSource:
SELECT * FROM content
WHERE type = ? AND source_id = ?
ORDER BY sort_order;

selectByTypeAndGroup:
SELECT * FROM content
WHERE type = ? AND group_name = ?
ORDER BY sort_order;

distinctGroupsForType:
SELECT DISTINCT group_name FROM content
WHERE type = ? AND group_name IS NOT NULL
ORDER BY group_name;

searchFts:
SELECT c.*
FROM content c
JOIN content_fts f ON f.content_id = c.id
WHERE content_fts MATCH :query
ORDER BY c.type, c.sort_order
LIMIT :limitCount;

insert:
INSERT INTO content (
    id, source_id, type, title, clean_title, group_name,
    stream_url, logo_url, tvg_id, metadata_json,
    sort_order, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteBySource:
DELETE FROM content WHERE source_id = ?;

-- One-shot FTS wipe for a source. Paired with `deleteBySource` in
-- ContentWriter to replace the per-row `content_ad` trigger.
deleteFtsBySource:
DELETE FROM content_fts
 WHERE content_id IN (SELECT id FROM content WHERE source_id = :sourceId);


countBySource:
SELECT COUNT(*) FROM content WHERE source_id = ?;

countByType:
SELECT COUNT(*) FROM content WHERE type = ?;

countByTypeAndGroup:
SELECT COUNT(*) FROM content WHERE type = ? AND group_name = ?;

listByTypePaged:
SELECT * FROM content
WHERE type = ?
ORDER BY source_id, sort_order
LIMIT :limitCount OFFSET :offsetCount;

listByTypeAndGroupPaged:
SELECT * FROM content
WHERE type = ? AND group_name = ?
ORDER BY sort_order
LIMIT :limitCount OFFSET :offsetCount;

-- Guide channel list: distinct live channels that have at least one programme
-- in the [startTime, endTime) window. Joins epg_programmes so channels with no
-- guide data are skipped (they render as "no data" rows otherwise). Ordered by
-- title for a stable, alphabetical channels column in the grid.
guideChannelsAll:
SELECT DISTINCT c.tvg_id, c.title, c.clean_title, c.logo_url, c.stream_url
FROM content c
INNER JOIN epg_programmes ep ON ep.channel_tvg_id = c.tvg_id
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND ep.end_time > :startTime AND ep.start_time < :endTime
ORDER BY c.title ASC;

guideChannelsBySource:
SELECT DISTINCT c.tvg_id, c.title, c.clean_title, c.logo_url, c.stream_url
FROM content c
INNER JOIN epg_programmes ep ON ep.channel_tvg_id = c.tvg_id
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND c.source_id = :sourceId
  AND ep.end_time > :startTime AND ep.start_time < :endTime
ORDER BY c.title ASC;
