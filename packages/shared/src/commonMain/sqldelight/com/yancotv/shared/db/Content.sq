-- Channels, movies, series entries. Mirrors migrations 001 + 003.
-- FTS4 (not FTS5) because Android's bundled SQLite doesn't ship FTS5
-- on every device/API level.

CREATE TABLE content (
    id TEXT PRIMARY KEY NOT NULL,
    source_id TEXT NOT NULL REFERENCES sources(id) ON DELETE CASCADE,
    type TEXT NOT NULL CHECK(type IN ('live', 'movie', 'series')),
    title TEXT NOT NULL,
    clean_title TEXT,
    group_name TEXT,
    stream_url TEXT NOT NULL,
    logo_url TEXT,
    tvg_id TEXT,
    metadata_json TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    -- MK.13.2 — user-applied overrides for per-channel rename / custom logo.
    -- Both nullable; null means "use the M3U-shipped value". Lookup is
    -- read-through in ContentItem.displayTitle / displayLogoUrl so callers
    -- never branch on null. Not synced to FTS (search still matches the
    -- canonical title) — re-indexing on every rename would re-add the
    -- per-row write trigger v2.sqm explicitly removed.
    name_override TEXT,
    logo_override TEXT
);

CREATE INDEX idx_content_source ON content(source_id);
CREATE INDEX idx_content_type ON content(type);
CREATE INDEX idx_content_group ON content(group_name);
-- Audit catch — Home "Recently added" rail runs
-- `SELECT * FROM content WHERE type IN ('movie','series') ORDER BY created_at DESC LIMIT N`
-- on every Home open. Without a covering index this was a full sort
-- over the catalogue on every cold launch (on a 100k-row Xtream
-- catalogue that's measurable). Partial WHERE skips live rows so the
-- index stays tight.
CREATE INDEX idx_content_vod_created_at ON content(created_at DESC) WHERE type IN ('movie', 'series');
CREATE INDEX idx_content_clean_title ON content(clean_title);
CREATE INDEX idx_content_sort_order ON content(source_id, type, sort_order);
-- MK.EPG.D — composite (type, tvg_id) for Guide queries. Every Guide
-- channel-list query (`guideChannelsAll/BySource/ByGroupPaged`,
-- `selectLiveByTvgId`, `distinctLiveTvgIds`, `distinctGuideGroups`)
-- filters `type = 'live'` then probes/groups on `tvg_id`. With only
-- `idx_content_type` the planner seeks to the live block then scans
-- the full live row set per query — that's the entire live catalog
-- (5–20k rows on typical IPTV providers). The composite turns the
-- type+tvg_id filter into a single index seek and lets `GROUP BY
-- c.tvg_id` consume rows in index order, eliminating a sort step.
-- Migration in 10.sqm picks it up for existing DBs.
CREATE INDEX idx_content_type_tvg ON content(type, tvg_id);

-- unicode61 + remove_diacritics lets non-Latin titles (Arabic, Cyrillic,
-- accented Latin) match without requiring the user to type diacritics.
-- Default ASCII tokenizer would silently drop these into one opaque bucket.
-- unicode61 splits non-Latin scripts correctly (Arabic, Cyrillic, accented
-- Latin). FTS4's tokenize argument is a single token, so the parameter-style
-- form "unicode61 remove_diacritics=1" is rejected by some SQLite builds as
-- an unknown tokenizer. We drop the diacritics flag here and handle case-
-- folding/diacritic stripping in clean_title at write time instead.
CREATE VIRTUAL TABLE content_fts USING fts4(
    content_id,
    title,
    clean_title,
    group_name,
    tokenize=unicode61
);

CREATE TRIGGER content_ai AFTER INSERT ON content BEGIN
    INSERT INTO content_fts (content_id, title, clean_title, group_name)
    VALUES (new.id, new.title, new.clean_title, new.group_name);
END;

-- `content_ad` (per-row FTS delete trigger) was removed in MK.6.d: it made a
-- whole-catalog resync take minutes. FTS4's virtual table has no index on
-- `content_id`, so each trigger fire scanned the entire FTS → O(N²) for an
-- N-row wipe (50k rows ≈ 2.5B scans). It also wedged the thread enough to
-- make Cancel unresponsive. FTS is now cleared explicitly in a single bulk
-- statement (`deleteFtsBySource`) before the content DELETE.
--
-- `content_au` was also removed — we never do row UPDATEs today; rows are
-- only inserted (via bulk writes) or wiped (via `deleteBySource`). If we
-- ever add an UPDATE path it needs matching manual FTS handling.

selectById:
SELECT * FROM content WHERE id = ?;

-- Distinct tvg_ids for live channels. Used by the Android EPG streamer to
-- discard programmes whose channel the user doesn't have — a massive feed
-- (the IPTV providers ship every channel on earth) can be filtered down to
-- just the rows we'll ever display, cutting DB writes by 50–90% for users
-- whose catalog is a small subset of the feed.
distinctLiveTvgIds:
SELECT DISTINCT tvg_id FROM content
WHERE type = 'live' AND tvg_id IS NOT NULL AND tvg_id != '';

-- Pick the highest-priority live channel carrying a given tvg_id. A tvg_id
-- can be shared across sources (same feed, multiple providers); the Guide
-- shows one row per tvg_id, so catchup lookup needs to pick a single backing
-- source. Priority ORDER BY matches how the sources list is ordered in the
-- UI — user's preferred provider wins.
selectLiveByTvgId:
SELECT c.* FROM content c
JOIN sources s ON s.id = c.source_id
WHERE c.type = 'live' AND c.tvg_id = ?
ORDER BY s.priority ASC, c.sort_order ASC
LIMIT 1;

selectByType:
SELECT * FROM content
WHERE type = ?
ORDER BY source_id, sort_order;

selectByTypeAndSource:
SELECT * FROM content
WHERE type = ? AND source_id = ?
ORDER BY sort_order;

selectByTypeAndGroup:
SELECT * FROM content
WHERE type = ? AND group_name = ?
ORDER BY sort_order;

-- MK.20.1 — provider order, not alphabetical. Providers ship groups in a
-- deliberate order (favourites first, then sports, then geos); alphabetising
-- threw that signal away. MIN(sort_order) per group gives the index of the
-- first row tagged with that group, which matches arrival order from the
-- M3U/Xtream parse. Backed by idx_content_sort_order(source_id, type,
-- sort_order) — no new index.
distinctGroupsForType:
SELECT group_name FROM content
WHERE type = ? AND group_name IS NOT NULL
GROUP BY group_name
ORDER BY MIN(sort_order);

searchFts:
SELECT c.*
FROM content c
JOIN content_fts f ON f.content_id = c.id
WHERE content_fts MATCH :query
ORDER BY c.type, c.sort_order
LIMIT :limitCount;

-- MK.search.rails — per-type FTS search. Needed because the unified
-- `searchFts` orders by `c.type` and a heavy live catalog can exhaust
-- a 100-row limit entirely within live, leaving zero movies/series in
-- the results. Caller hits this three times (one per type) so each
-- rail gets its own slice independently.
searchFtsByType:
SELECT c.*
FROM content c
JOIN content_fts f ON f.content_id = c.id
WHERE content_fts MATCH :query AND c.type = :type
ORDER BY c.sort_order
LIMIT :limitCount;

insert:
INSERT INTO content (
    id, source_id, type, title, clean_title, group_name,
    stream_url, logo_url, tvg_id, metadata_json,
    sort_order, created_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Merges enriched detail metadata (plot, cast, backdrop, episodes) into an
-- existing row without touching the sort-critical columns. Used by the
-- detail screen after a lazy get_vod_info / get_series_info fetch.
updateMetadataAndLogo:
UPDATE content
SET metadata_json = :metadataJson,
    logo_url = COALESCE(:logoUrl, logo_url)
WHERE id = :id;

-- MK.13.2 — per-channel rename. Either argument may be null which clears the
-- corresponding override. Used by ChannelActionsMenu's Rename + Custom logo
-- rows (and by a future "restore default" path).
setOverrides:
UPDATE content
SET name_override = :nameOverride,
    logo_override = :logoOverride
WHERE id = :id;

-- MK.19.8 — backup engine dumps just the override columns paired with
-- the (source_id, stream_url) tuple used to re-link on import. The
-- content rows themselves are re-fetched from sources after restore so
-- only the user-applied overrides need to round-trip.
selectOverridesForBackup:
SELECT source_id, stream_url, name_override, logo_override
FROM content
WHERE name_override IS NOT NULL OR logo_override IS NOT NULL;

-- MK.19.8.2 — backup importer's re-link path. Maps a backup-side
-- (source_id, stream_url) pair to the local content_id post-resync.
-- Returns the most recent row if a stream_url collides across types
-- under the same source (e.g. a movie and live channel sharing a URL —
-- rare but possible with badly-tagged providers).
findIdBySourceAndStreamUrl:
SELECT id FROM content
WHERE source_id = :sourceId AND stream_url = :streamUrl
ORDER BY created_at DESC
LIMIT 1;

-- MK.19.8 audit fix #1 — recording rows on import only have a stream_url
-- (no source_id was exported), so re-link is by stream_url alone.
-- Lossier than the (source, url) tuple but enough to restore the "play
-- this recording's source channel" affordance for the common case where
-- a stream_url is unique across the catalog.
findIdByStreamUrl:
SELECT id FROM content
WHERE stream_url = :streamUrl
ORDER BY created_at DESC
LIMIT 1;

deleteBySource:
DELETE FROM content WHERE source_id = ?;

-- One-shot FTS wipe for a source. Paired with `deleteBySource` in
-- ContentWriter to replace the per-row `content_ad` trigger.
deleteFtsBySource:
DELETE FROM content_fts
 WHERE content_id IN (SELECT id FROM content WHERE source_id = :sourceId);


countBySource:
SELECT COUNT(*) FROM content WHERE source_id = ?;

countByType:
SELECT COUNT(*) FROM content WHERE type = ?;

countByTypeAndGroup:
SELECT COUNT(*) FROM content WHERE type = ? AND group_name = ?;

listByTypePaged:
SELECT * FROM content
WHERE type = ?
ORDER BY source_id, sort_order
LIMIT :limitCount OFFSET :offsetCount;

listByTypeAndGroupPaged:
SELECT * FROM content
WHERE type = ? AND group_name = ?
ORDER BY sort_order
LIMIT :limitCount OFFSET :offsetCount;

-- Latest VOD rows across the whole catalogue, newest first. Used by the
-- Home dashboard's "Recently added" rail — the regular listByTypePaged
-- query sorts by source_id + sort_order (playlist position), which is
-- the wrong order for "what arrived last". Mixes movies + series so the
-- caller gets a single sorted stream and doesn't have to merge + re-sort
-- client-side.
recentlyAddedVod:
SELECT * FROM content
WHERE type IN ('movie', 'series')
ORDER BY created_at DESC
LIMIT :limitCount;

-- Guide channel list: distinct live channels that have at least one programme
-- in the [startTime, endTime) window. Joins epg_programmes so channels with no
-- guide data are skipped (they render as "no data" rows otherwise). Ordered by
-- title for a stable, alphabetical channels column in the grid.
-- GROUP BY c.tvg_id picks ONE row per channel even when the catalog has
-- multiple content rows sharing the same tvg_id (1080p / 720p / backup
-- variants are common on Xtream providers). DISTINCT on the full tuple
-- would keep all variants and then the Compose LazyColumn's uniqueness
-- check on the key crashes with "Key X was already used".
--
-- EXISTS (instead of INNER JOIN on epg_programmes) avoids row
-- multiplication — a JOIN produces one output row per matching programme
-- in the window, which is up to ~48 per channel before GROUP BY collapses
-- them. EXISTS short-circuits as soon as one programme matches.
--
-- MK.EPG.H — order by provider position (`MIN(c.sort_order)`), not
-- alphabetical title. IPTV providers ship channels in a deliberate
-- order: favourites first, then sports, then news/entertainment,
-- then geo-tagged feeds. Alphabetising threw that signal away —
-- "Channel 1" landed between "AlJazeera" and "BBC" instead of at
-- the top of the list. TiviMate-style provider order matches user
-- expectation and makes the M3U `tvg-chno` / playlist position
-- carry meaning. Mirrors the same fix MK.20.1 applied to category
-- groups (`distinctGroupsForType`, `distinctGuideGroups`).
--
-- MIN over the GROUP BY tvg_id pick — when two content variants
-- share a tvg_id (1080p + 720p, or two sources both shipping the
-- same channel), the earliest playlist position wins. Equal-
-- sort_order ties resolve by tvg_id secondary sort, which keeps
-- LIMIT/OFFSET pagination deterministic across pages (without it
-- the user can scroll and see the same channel repeat on page
-- boundaries).

guideChannelsAll:
SELECT c.tvg_id, c.title, c.clean_title, c.logo_url, c.stream_url
FROM content c
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND EXISTS (
    SELECT 1 FROM epg_programmes ep
    WHERE ep.channel_tvg_id = c.tvg_id
      AND ep.end_time > :startTime AND ep.start_time < :endTime
  )
GROUP BY c.tvg_id
ORDER BY MIN(c.sort_order) ASC, c.tvg_id ASC;

guideChannelsBySource:
SELECT c.tvg_id, c.title, c.clean_title, c.logo_url, c.stream_url
FROM content c
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND c.source_id = :sourceId
  AND EXISTS (
    SELECT 1 FROM epg_programmes ep
    WHERE ep.channel_tvg_id = c.tvg_id
      AND ep.end_time > :startTime AND ep.start_time < :endTime
  )
GROUP BY c.tvg_id
ORDER BY MIN(c.sort_order) ASC, c.tvg_id ASC;

guideChannelsAllPaged:
SELECT c.tvg_id, c.title, c.clean_title, c.logo_url, c.stream_url, MIN(c.sort_order) AS sort_order
FROM content c
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND EXISTS (
    SELECT 1 FROM epg_programmes ep
    WHERE ep.channel_tvg_id = c.tvg_id
      AND ep.end_time > :startTime AND ep.start_time < :endTime
  )
GROUP BY c.tvg_id
ORDER BY MIN(c.sort_order) ASC, c.tvg_id ASC
LIMIT :limit OFFSET :offset;

guideChannelsBySourcePaged:
SELECT c.tvg_id, c.title, c.clean_title, c.logo_url, c.stream_url, MIN(c.sort_order) AS sort_order
FROM content c
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND c.source_id = :sourceId
  AND EXISTS (
    SELECT 1 FROM epg_programmes ep
    WHERE ep.channel_tvg_id = c.tvg_id
      AND ep.end_time > :startTime AND ep.start_time < :endTime
  )
GROUP BY c.tvg_id
ORDER BY MIN(c.sort_order) ASC, c.tvg_id ASC
LIMIT :limit OFFSET :offset;

countGuideChannelsAll:
SELECT COUNT(DISTINCT c.tvg_id) FROM content c
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND EXISTS (
    SELECT 1 FROM epg_programmes ep
    WHERE ep.channel_tvg_id = c.tvg_id
      AND ep.end_time > :startTime AND ep.start_time < :endTime
  );

countGuideChannelsBySource:
SELECT COUNT(DISTINCT c.tvg_id) FROM content c
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND c.source_id = :sourceId
  AND EXISTS (
    SELECT 1 FROM epg_programmes ep
    WHERE ep.channel_tvg_id = c.tvg_id
      AND ep.end_time > :startTime AND ep.start_time < :endTime
  );

-- MK.guide.groups — group-filtered guide channel listing. Mirrors
-- guideChannelsAllPaged but constrains to a single group_name. Used by
-- GuideScreen's group chip strip so the user can narrow the guide to
-- (e.g.) Sports without scrolling through every live channel.
-- MK.EPG.H — provider order, see comment block above guideChannelsAll.
guideChannelsByGroupPaged:
SELECT c.tvg_id, c.title, c.clean_title, c.logo_url, c.stream_url, MIN(c.sort_order) AS sort_order
FROM content c
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND c.group_name = :groupName
  AND EXISTS (
    SELECT 1 FROM epg_programmes ep
    WHERE ep.channel_tvg_id = c.tvg_id
      AND ep.end_time > :startTime AND ep.start_time < :endTime
  )
GROUP BY c.tvg_id
ORDER BY MIN(c.sort_order) ASC, c.tvg_id ASC
LIMIT :limit OFFSET :offset;

countGuideChannelsByGroup:
SELECT COUNT(DISTINCT c.tvg_id) FROM content c
WHERE c.type = 'live' AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND c.group_name = :groupName
  AND EXISTS (
    SELECT 1 FROM epg_programmes ep
    WHERE ep.channel_tvg_id = c.tvg_id
      AND ep.end_time > :startTime AND ep.start_time < :endTime
  );

-- Live-only group list with EPG coverage. Drives the guide's group
-- chip strip so the picker only shows groups the user can actually
-- filter by (a Sports group with no EPG-covered channel would be a
-- dead chip).
-- MK.20.1 — provider order, see distinctGroupsForType note above.
distinctGuideGroups:
SELECT c.group_name FROM content c
WHERE c.type = 'live'
  AND c.group_name IS NOT NULL AND c.group_name != ''
  AND c.tvg_id IS NOT NULL AND c.tvg_id != ''
  AND EXISTS (
    SELECT 1 FROM epg_programmes ep
    WHERE ep.channel_tvg_id = c.tvg_id
      AND ep.end_time > :startTime AND ep.start_time < :endTime
  )
GROUP BY c.group_name
ORDER BY MIN(c.sort_order);
