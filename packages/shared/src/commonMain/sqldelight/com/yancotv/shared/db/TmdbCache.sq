CREATE TABLE tmdb_cache (
    content_id TEXT PRIMARY KEY NOT NULL,
    tmdb_id INTEGER,
    tmdb_type TEXT CHECK(tmdb_type IN ('movie', 'tv')),
    payload_json TEXT,
    miss INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    fetched_at INTEGER NOT NULL
);

CREATE INDEX idx_tmdb_cache_fetched_at ON tmdb_cache(fetched_at);

selectByContent:
SELECT * FROM tmdb_cache WHERE content_id = ?;

upsert:
INSERT OR REPLACE INTO tmdb_cache (content_id, tmdb_id, tmdb_type, payload_json, miss, fetched_at)
VALUES (?, ?, ?, ?, ?, ?);

deleteStale:
DELETE FROM tmdb_cache WHERE fetched_at < ?;
