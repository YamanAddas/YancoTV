{
  "name": "@yancotv/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "YancoTV Android TV + phone app (React Native)",
  "scripts": {
    "android": "react-native run-android",
    "android:tv": "react-native run-android --appId com.yancotv.mobile --main-activity .MainActivity",
    "start": "react-native start",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@shopify/flash-list": "^1.7.1",
    "@tanstack/react-query": "^5.59.0",
    "@yancotv/core": "workspace:*",
    "nativewind": "^4.1.0",
    "react": "18.3.1",
    "react-native": "npm:react-native-tvos@0.76.1-0",
    "react-native-keychain": "^8.2.0",
    "react-native-reanimated": "^3.16.0",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "^4.0.0",
    "react-native-svg": "^15.8.0",
    "react-native-video": "^6.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "^0.76.0",
    "@react-native/eslint-config": "^0.76.0",
    "@react-native/metro-config": "^0.76.0",
    "@react-native/typescript-config": "^0.76.0",
    "@types/react": "^18.3.12",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
