<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:shutter_background_color="@android:color/black" />

    <!-- Recording status indicator (MK.14.2-fix). Top-end pill that's
         visible while a recording for the playing channel is in flight.
         Eager-inflated (zero-cost when idle — observes a StateFlow,
         renders nothing until it sees an active row). Fire TV doesn't
         show our system foreground-service notification over fullscreen
         video by design (Amazon docs), so this is the user's primary
         "is it recording?" feedback. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/recording_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp" />

    <!-- MK.25.A.2 — transient seek-flash overlay. Renders a +Ns/-Ns
         badge for 600 ms on each LEFT/RIGHT seek press, with multi-
         press coalescing inside the window. Eager-inflated like
         recording_indicator (zero cost when idle — observes a
         StateFlow, renders nothing while seekFlashFlow.value == 0). -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/seek_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- MK.11.2 — phone swipe HUD (brightness / volume / seek). Eager like
         seek_flash and equally quiet when idle: it observes a StateFlow and
         renders an empty Box while that is null. Never focusable or
         clickable — it must not intercept the touches that drive it, and it
         must not appear in the D-pad focus order on TV, where the gestures
         that feed it are not wired at all. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/gesture_hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Quick info (stream diagnostics): top-end, toggled by INFO / GUIDE keys. -->
    <LinearLayout
        android:id="@+id/quick_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:minWidth="240dp"
        android:orientation="vertical"
        android:background="@drawable/player_overlay_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pl_stream_info"
            android:textColor="#FF4FC3F7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/qi_resolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_codec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_bitrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_buffer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.6"
            android:text="@string/pl_info_dismiss"
            android:textColor="#FFE6EDF3"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Jump-to-LIVE affordance (MK.8.2 timeshift). Renders when the
         player is more than a few seconds behind the live edge —
         typically after a pause or user rewind. Top-end, under the
         quick-info panel's horizontal slot so both overlays can
         coexist without overlap. -->
    <LinearLayout
        android:id="@+id/live_jump_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/player_live_jump_pill"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/player_live_dot"
            android:alpha="1.0" />

        <TextView
            android:id="@+id/live_offset_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFE6EDF3"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="14dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/live_jump_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pl_jump_to_live"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FF00E28A"
            android:background="@android:color/transparent"
            android:letterSpacing="0.15"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- Channel-surf overlay: TiviMate-style translucent channel list that
         rides over the live stream. Hosted as a ComposeView so the list,
         focus, and now/next reuse existing Compose code paths. Anchored
         right-edge, fixed width, never full-screen — the video stays
         visible beneath it.

         Wrapped in a ViewStub so the ComposeView's Compose owner /
         Recomposer / saveable state registry isn't built during
         PlayerActivity.onCreate. Most fullscreen sessions never open the
         surf overlay; deferring the inflation drops ~150 ms off the
         launch path on Fire TV Stick. PlayerActivity.showSurf() inflates
         the stub on first use. -->
    <ViewStub
        android:id="@+id/surf_overlay_stub"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:inflatedId="@+id/surf_overlay"
        android:layout="@layout/player_surf_overlay" />

    <!-- 2026-04-27 — legacy player-options sheet retired. MENU now
         opens the V2 popup (player_options_v2_stub below) for both
         LIVE and VOD; PlayerOptionsSheet.kt was deleted in the same
         commit. The player_options_sheet drawable layout file is
         orphaned and can be removed in a follow-up sweep. -->

    <!-- VOD dock (MK.16.player.vod.dock). Compose replacement for Media3's
         built-in PlayerControlView when the current item is non-live.
         Inflated lazily from `PlayerActivity.ensureVodDockOverlay()` on
         the first OK/CENTER press during VOD playback. -->
    <ViewStub
        android:id="@+id/vod_dock_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/vod_dock"
        android:layout="@layout/player_vod_dock" />

    <!-- MB-343 (W4) — up-next card. Names the queued episode and counts down
         during the last 20 s of a series episode. Eager-inflated like
         seek_flash (zero cost when idle — observes a StateFlow and renders
         nothing while `visible` is false), and wrap_content so it can never
         swallow a touch aimed at the player beneath it.

         Placed after vod_dock_stub so it paints above the dock, but before the
         options popup / channel-zap / chrome / cast overlays so those still
         cover it. In practice it is suppressed while the dock is up
         (UpNextDecision.shouldShow), so the ordering only matters for the
         surfaces that can appear on top of it.

         The 148dp bottom margin clears Media3's subtitle band. At 64dp the card
         sat inside it and covered closing dialogue — precisely the moment the
         card appears. The subtitle view's own bottom-padding fraction plus two
         lines of cue text needs roughly 140dp of the Fire TV's 540dp viewport.

         clickable + focusable false: the card is informational only. The
         "play it now" affordance is the dock's NEXT transport button — see the
         UpNextOverlay KDoc for why this deliberately owns no focus target and
         no key binding. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/up_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="148dp"
        android:clickable="false"
        android:focusable="false" />

    <!-- Phone player chrome (MB-231 / MK.26.A.3). The player is D-pad-first;
         on a phone it needs touch affordances. Placed ABOVE the VOD dock in
         the z-order so it also shows over movies/series (the dock is a
         full-screen ComposeView). Visibility driven by
         PlayerActivity.updatePlayerChrome(): phone only, while the live
         controller OR the VOD dock is visible. Hidden on TV — the remote's
         BACK key + MENU / long-press own these there. focusable=false so the
         buttons never enter D-pad focus traversal. -->
    <ImageButton
        android:id="@+id/player_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/player_overlay_pill"
        android:src="@drawable/ic_player_back"
        android:scaleType="centerInside"
        android:padding="10dp"
        android:focusable="false"
        android:contentDescription="Back"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/player_top_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

<!-- MK.28.7 / MB-272 — touch entry to the channel-surf overlay. Zapping
             is the core IPTV loop but every entry was a TV key code; a phone
             user had to exit the player and re-pick to change channels.
             Visibility gated LIVE-only in updatePlayerChrome(). -->
        <ImageButton
            android:id="@+id/player_channels_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/player_overlay_pill"
            android:src="@drawable/ic_player_channels"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:focusable="false"
            android:contentDescription="Channel list"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/player_more_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/player_overlay_pill"
            android:src="@drawable/ic_player_more"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:focusable="false"
            android:contentDescription="More options" />

        <ImageButton
            android:id="@+id/player_cast_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/player_overlay_pill"
            android:src="@drawable/ic_player_cast"
            android:scaleType="centerInside"
            android:padding="11dp"
            android:focusable="false"
            android:contentDescription="Cast or play on TV" />
    </LinearLayout>

    <!-- MK.options.redesign — lightweight options popup + per-category
         floating panels. Replaces the heavy MK.16.sheet entry path on the
         live player. Hosts a single ComposeView that paints both the menu
         and the active panel in one layer. Lazy-inflated on first MENU
         press. -->
    <ViewStub
        android:id="@+id/player_options_v2_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/player_options_v2"
        android:layout="@layout/player_options_v2_overlay" />

    <!-- MK.10.4 — channel-zap numeric input overlay. Slides up bottom-left
         when the user types digits (0–9) on a live channel. Commits on OK
         or after a short idle window. Inflated lazily on first digit —
         most sessions never type a number. -->
    <ViewStub
        android:id="@+id/channel_zap_overlay_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/channel_zap_overlay"
        android:layout="@layout/player_channel_zap_overlay" />

    <!-- VOD player chrome (MK.16.player.vod.chrome). Hosts Compose overlays
         for buffering + error states — the Concept A port of the "Tuning
         the stream" + "Couldn't open this stream" screens. Replaces the
         earlier `stream_error_overlay` LinearLayout. Inflated lazily from
         `PlayerActivity.ensureChromeOverlay()` on first buffer/error —
         most playback sessions never trigger either state. -->
    <ViewStub
        android:id="@+id/vod_chrome_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/vod_chrome"
        android:layout="@layout/player_vod_chrome" />

    <!-- MK.26.B — Chromecast sender state. While a Cast session is active the
         local player is paused (no double-playback), so instead of leaving the
         phone on a frozen frame this covers it with a "Casting to <device>"
         card + a Stop control. Topmost child so it sits over everything.
         clickable=true so taps don't fall through to the player beneath. GONE
         by default; PlayerActivity shows it only while CastController.sessionState
         is Active — so it never appears where Cast is unavailable. -->
    <LinearLayout
        android:id="@+id/cast_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_player_cast"
            android:contentDescription="@null"
            android:alpha="0.92" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pl_casting"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cast_overlay_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="center"
            android:textColor="#FFB9C4CF"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cast_overlay_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/pl_stop_casting"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:letterSpacing="0.04"
            android:background="@drawable/player_overlay_pill"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:focusable="true"
            android:focusableInTouchMode="false" />
    </LinearLayout>

</FrameLayout>
