<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:shutter_background_color="@android:color/black" />

    <!-- Recording status indicator (MK.14.2-fix). Top-end pill that's
         visible while a recording for the playing channel is in flight.
         Eager-inflated (zero-cost when idle — observes a StateFlow,
         renders nothing until it sees an active row). Fire TV doesn't
         show our system foreground-service notification over fullscreen
         video by design (Amazon docs), so this is the user's primary
         "is it recording?" feedback. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/recording_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp" />

    <!-- MK.25.A.2 — transient seek-flash overlay. Renders a +Ns/-Ns
         badge for 600 ms on each LEFT/RIGHT seek press, with multi-
         press coalescing inside the window. Eager-inflated like
         recording_indicator (zero cost when idle — observes a
         StateFlow, renders nothing while seekFlashFlow.value == 0). -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/seek_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Zap bar: channel name + now/next, top-start. Fades with Media3 controller. -->
    <LinearLayout
        android:id="@+id/zap_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:maxWidth="520dp"
        android:orientation="vertical"
        android:background="@drawable/player_overlay_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/zap_live_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/player_live_dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/zap_live_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="LIVE"
                android:textColor="#FFE53935"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <TextView
                android:id="@+id/zap_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/zap_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFE6EDF3"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/zap_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textColor="#FFE6EDF3"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Quick info (stream diagnostics): top-end, toggled by INFO / GUIDE keys. -->
    <LinearLayout
        android:id="@+id/quick_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:minWidth="240dp"
        android:orientation="vertical"
        android:background="@drawable/player_overlay_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAM INFO"
            android:textColor="#FF4FC3F7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/qi_resolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_codec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_bitrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_buffer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.6"
            android:text="INFO to dismiss"
            android:textColor="#FFE6EDF3"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Program progress bar (live TV only): bottom, above default Media3 controls. -->
    <LinearLayout
        android:id="@+id/program_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="96dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/pp_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#FF000000"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/pp_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FFE6EDF3"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:shadowColor="#FF000000"
                android:shadowRadius="6" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pp_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/player_progress" />
    </LinearLayout>

    <!-- Jump-to-LIVE affordance (MK.8.2 timeshift). Renders when the
         player is more than a few seconds behind the live edge —
         typically after a pause or user rewind. Top-end, under the
         quick-info panel's horizontal slot so both overlays can
         coexist without overlap. -->
    <LinearLayout
        android:id="@+id/live_jump_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/player_live_jump_pill"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/player_live_dot"
            android:alpha="1.0" />

        <TextView
            android:id="@+id/live_offset_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFE6EDF3"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="14dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/live_jump_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JUMP TO LIVE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FF00E28A"
            android:background="@android:color/transparent"
            android:letterSpacing="0.15"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- Channel-surf overlay: TiviMate-style translucent channel list that
         rides over the live stream. Hosted as a ComposeView so the list,
         focus, and now/next reuse existing Compose code paths. Anchored
         right-edge, fixed width, never full-screen — the video stays
         visible beneath it.

         Wrapped in a ViewStub so the ComposeView's Compose owner /
         Recomposer / saveable state registry isn't built during
         PlayerActivity.onCreate. Most fullscreen sessions never open the
         surf overlay; deferring the inflation drops ~150 ms off the
         launch path on Fire TV Stick. PlayerActivity.showSurf() inflates
         the stub on first use. -->
    <ViewStub
        android:id="@+id/surf_overlay_stub"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:inflatedId="@+id/surf_overlay"
        android:layout="@layout/player_surf_overlay" />

    <!-- 2026-04-27 — legacy player-options sheet retired. MENU now
         opens the V2 popup (player_options_v2_stub below) for both
         LIVE and VOD; PlayerOptionsSheet.kt was deleted in the same
         commit. The player_options_sheet drawable layout file is
         orphaned and can be removed in a follow-up sweep. -->

    <!-- VOD dock (MK.16.player.vod.dock). Compose replacement for Media3's
         built-in PlayerControlView when the current item is non-live.
         Inflated lazily from `PlayerActivity.ensureVodDockOverlay()` on
         the first OK/CENTER press during VOD playback. -->
    <ViewStub
        android:id="@+id/vod_dock_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/vod_dock"
        android:layout="@layout/player_vod_dock" />

    <!-- MK.options.redesign — lightweight options popup + per-category
         floating panels. Replaces the heavy MK.16.sheet entry path on the
         live player. Hosts a single ComposeView that paints both the menu
         and the active panel in one layer. Lazy-inflated on first MENU
         press. -->
    <ViewStub
        android:id="@+id/player_options_v2_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/player_options_v2"
        android:layout="@layout/player_options_v2_overlay" />

    <!-- MK.10.4 — channel-zap numeric input overlay. Slides up bottom-left
         when the user types digits (0–9) on a live channel. Commits on OK
         or after a short idle window. Inflated lazily on first digit —
         most sessions never type a number. -->
    <ViewStub
        android:id="@+id/channel_zap_overlay_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/channel_zap_overlay"
        android:layout="@layout/player_channel_zap_overlay" />

    <!-- VOD player chrome (MK.16.player.vod.chrome). Hosts Compose overlays
         for buffering + error states — the Concept A port of the "Tuning
         the stream" + "Couldn't open this stream" screens. Replaces the
         earlier `stream_error_overlay` LinearLayout. Inflated lazily from
         `PlayerActivity.ensureChromeOverlay()` on first buffer/error —
         most playback sessions never trigger either state. -->
    <ViewStub
        android:id="@+id/vod_chrome_stub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:inflatedId="@+id/vod_chrome"
        android:layout="@layout/player_vod_chrome" />

</FrameLayout>
