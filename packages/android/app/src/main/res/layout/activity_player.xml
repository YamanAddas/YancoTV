<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:shutter_background_color="@android:color/black" />

    <!-- Zap bar: channel name + now/next, top-start. Fades with Media3 controller. -->
    <LinearLayout
        android:id="@+id/zap_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:maxWidth="520dp"
        android:orientation="vertical"
        android:background="@drawable/player_overlay_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/zap_live_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/player_live_dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/zap_live_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="LIVE"
                android:textColor="#FFE53935"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:visibility="gone" />

            <TextView
                android:id="@+id/zap_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/zap_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFE6EDF3"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/zap_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.7"
            android:textColor="#FFE6EDF3"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Quick info (stream diagnostics): top-end, toggled by INFO / GUIDE keys. -->
    <LinearLayout
        android:id="@+id/quick_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:minWidth="240dp"
        android:orientation="vertical"
        android:background="@drawable/player_overlay_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STREAM INFO"
            android:textColor="#FF4FC3F7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/qi_resolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_codec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_bitrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_buffer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/qi_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:alpha="0.6"
            android:text="INFO to dismiss"
            android:textColor="#FFE6EDF3"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Program progress bar (live TV only): bottom, above default Media3 controls. -->
    <LinearLayout
        android:id="@+id/program_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="96dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/pp_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:shadowColor="#FF000000"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/pp_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#FFE6EDF3"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:shadowColor="#FF000000"
                android:shadowRadius="6" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pp_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/player_progress" />
    </LinearLayout>

    <!-- Jump-to-LIVE affordance (MK.8.2 timeshift). Renders when the
         player is more than a few seconds behind the live edge —
         typically after a pause or user rewind. Top-end, under the
         quick-info panel's horizontal slot so both overlays can
         coexist without overlap. -->
    <LinearLayout
        android:id="@+id/live_jump_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/player_overlay_pill"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/player_live_dot"
            android:alpha="0.6" />

        <TextView
            android:id="@+id/live_offset_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFE6EDF3"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginEnd="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/live_jump_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JUMP TO LIVE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFE53935"
            android:background="@android:color/transparent"
            android:letterSpacing="0.1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- Channel-surf overlay: TiviMate-style translucent channel list that
         rides over the live stream. Hosted as a ComposeView so the list,
         focus, and now/next reuse existing Compose code paths. Anchored
         right-edge, fixed width, never full-screen — the video stays
         visible beneath it.

         Wrapped in a ViewStub so the ComposeView's Compose owner /
         Recomposer / saveable state registry isn't built during
         PlayerActivity.onCreate. Most fullscreen sessions never open the
         surf overlay; deferring the inflation drops ~150 ms off the
         launch path on Fire TV Stick. PlayerActivity.showSurf() inflates
         the stub on first use. -->
    <ViewStub
        android:id="@+id/surf_overlay_stub"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:inflatedId="@+id/surf_overlay"
        android:layout="@layout/player_surf_overlay" />

    <!-- Stream error overlay: shown when ExoPlayer surfaces an unrecoverable
         error (connection failed, 403/404, codec gap). User can retry or
         back out to the shell. Hidden until onPlayerError fires. -->
    <LinearLayout
        android:id="@+id/stream_error_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stream unavailable"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/stream_error_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFE6EDF3"
            android:textSize="14sp"
            android:gravity="center"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/stream_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:background="@drawable/player_overlay_pill"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginEnd="12dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/stream_error_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textColor="#FFE6EDF3"
                android:background="@drawable/player_overlay_pill"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
