    <string name="net_sec_ua" translatable="false">User-Agent</string>
    <string name="net_sec_ua_sub">Some IPTV providers gate playlist or stream access by the request\'s User-Agent. Pick a known-good preset, or paste a custom string.</string>
    <string name="net_preset">Preset</string>
    <string name="net_preset_hint">Applied to every outgoing HTTP request from YancoTV. Switching is instant for new connections.</string>
    <string name="net_custom_ua">Custom User-Agent</string>
    <string name="net_custom_ua_desc">Verbatim string. Some providers require an exact match.</string>
    <string name="net_sec_timeouts">Timeouts</string>
    <string name="net_sec_timeouts_sub">How long YancoTV waits before giving up on a slow source. Applied to playlists, EPG fetches and stream probes.</string>
    <string name="net_connect_timeout">Connect timeout</string>
    <string name="net_connect_timeout_hint">How long to wait for the TCP connection to open before retrying.</string>
    <string name="net_read_timeout">Read timeout</string>
    <string name="net_read_timeout_hint">Max idle time on an open connection before reconnecting.</string>
