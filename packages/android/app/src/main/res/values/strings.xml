    <string name="net_paired_tv_desc">Your TV\'s IPv4 address or hostname. Leave blank to unpair. Port 8731 is fixed.</string>
    <string name="net_pairing_code">Pairing code</string>
    <string name="net_pairing_code_desc">On a TV: the code to type into your phone. On a phone: enter your TV\'s code here.</string>
    <string name="net_test_connection">Test connection</string>
    <string name="net_test_connection_hint">Sends a small GET to your first active source. The credentials, URL and timeouts above are all exercised.</string>
