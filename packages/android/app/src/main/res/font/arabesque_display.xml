<?xml version="1.0" encoding="utf-8"?>
<!--
    Stage 5.2 / About-tab redesign — downloadable Google Font for the
    arabesque-feeling version label on Settings → About. Cinzel
    Decorative is a Latin-alphabet display face with ornate flourishes
    that read as decorative without going full script (still legible at
    10ft on Fire TV). System resolves via Google Fonts provider on first
    use and caches; offline-first launches fall back to the platform
    default until the font is fetched.

    Picked Cinzel Decorative over Lobster / Tangerine because:
      * Holds up at small + large sizes (versions appear at ~13sp, the
        wordmark tier we use on the hero is ~32sp).
      * Doesn't require Italic / cursive tracking adjustments.
      * Fee — Open Font License via Google Fonts (no licensing wrinkle).
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="name=Cinzel+Decorative&amp;weight=700"
    app:fontProviderCerts="@array/com_google_android_gms_fonts_certs">
</font-family>
