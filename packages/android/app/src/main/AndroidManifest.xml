<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WAKE_LOCK lets ExoPlayer hold a partial wake lock while buffering so
         the screen-off phone doesn't drop the stream mid-segment. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Programme reminders need exact-alarm scheduling. USE_EXACT_ALARM is
         the non-revocable variant for bona-fide alarm/reminder apps (which we
         are). Without it, `setExactAndAllowWhileIdle` throws SecurityException
         on API 31+. SCHEDULE_EXACT_ALARM is the user-revocable fallback. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Stage 3.1 / MK.14.1e — recording foreground service. The
         FOREGROUND_SERVICE base permission is needed on every Android
         release that ships foreground services. The matching
         FOREGROUND_SERVICE_DATA_SYNC permission is required from
         Android 14 (API 34) to declare `dataSync` as the service type;
         on earlier releases it's a harmless no-op. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- MK.14.X audit-revised storage path: legacy direct writes to
         /storage/emulated/0/Movies/YancoTV/ on Fire OS 7 / API 28 (where
         MediaStore RELATIVE_PATH isn't available yet). On API 29+ the
         permission is silently ignored — MediaStore writes don't need
         it under scoped storage — so this is Fire-TV-only in practice.
         maxSdkVersion="28" keeps the permission off the install
         consent screen on modern phones / Google TV / Chromecast. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11+ package visibility: lets us resolve the speech recognizer
         intent used by the voice-input buttons on Fire TV remotes, AND query
         installed external video players for the MK.18.1 "Open in external"
         action. The explicit <package> entries cover the direct-detection
         path (PackageInfo lookup); the <intent> filters cover the chooser
         fallback for any other installed video player. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="rtsp" />
        </intent>
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="com.brouken.player" />
    </queries>

    <application
        android:name=".YancoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.YancoTV"
        android:usesCleartextTraffic="true">

        <!-- Stage 1.3 — disable Sentry's auto-init ContentProvider. We init
             manually in YancoApp.onCreate via SentryInit.install(this) so the
             DSN can be sourced from local.properties (gitignored, per-machine)
             instead of being baked into the manifest. The auto-init provider
             would otherwise crash with "DSN is required" on launch. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:logo="@drawable/tv_banner"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateHidden|adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/PlayerTheme"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|smallestScreenSize" />

        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Stage 3.1 / MK.14.1e — foreground service that owns every
             in-flight recording. `dataSync` is the appropriate type
             (we're streaming bytes from the network and writing them
             to a file; not media playback / not user-visible camera). -->
        <service
            android:name=".recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
