<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WAKE_LOCK lets ExoPlayer hold a partial wake lock while buffering so
         the screen-off phone doesn't drop the stream mid-segment. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- MB-209 hardening — RecordingService.wifiLock holds a high-perf
         Wi-Fi lock while a recording is in flight so devices that
         power-save Wi-Fi during standby don't stall the OkHttp read
         mid-recording. CHANGE_WIFI_STATE is implied by createWifiLock
         on older API levels; declared explicitly for clarity. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Programme reminders need exact-alarm scheduling. USE_EXACT_ALARM is
         the non-revocable variant for bona-fide alarm/reminder apps (which we
         are). Without it, `setExactAndAllowWhileIdle` throws SecurityException
         on API 31+. SCHEDULE_EXACT_ALARM is the user-revocable fallback. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Stage 3.1 / MK.14.1e — recording foreground service. The
         FOREGROUND_SERVICE base permission is needed on every Android
         release that ships foreground services. The matching
         FOREGROUND_SERVICE_DATA_SYNC permission is required from
         Android 14 (API 34) to declare `dataSync` as the service type;
         on earlier releases it's a harmless no-op. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Stage 5.2.3 — sideload auto-update install flow. Lets the user
         tap "Install" inside the app and have the system PackageInstaller
         take over. On Android 8+ the user is also walked through the
         "Install unknown apps" system screen the first time (we route
         them there via Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES if
         packageManager.canRequestPackageInstalls() is false). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- MK.14.X audit-revised storage path: legacy direct writes to
         /storage/emulated/0/Movies/YancoTV/ on Fire OS 7 / API 28 (where
         MediaStore RELATIVE_PATH isn't available yet). On API 29+ the
         permission is silently ignored — MediaStore writes don't need
         it under scoped storage — so this is Fire-TV-only in practice.
         maxSdkVersion="28" keeps the permission off the install
         consent screen on modern phones / Google TV / Chromecast. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11+ package visibility: lets us resolve the speech recognizer
         intent used by the voice-input buttons on Fire TV remotes, AND query
         installed external video players for the MK.18.1 "Open in external"
         action. The explicit <package> entries cover the direct-detection
         path (PackageInfo lookup); the <intent> filters cover the chooser
         fallback for any other installed video player. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="rtsp" />
        </intent>
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="com.brouken.player" />
    </queries>

    <!--
        usesCleartextTraffic="true" is a deliberate, accepted threat-model
        decision — see AGENTS.md "Cleartext traffic (Android)" and
        bugs.md MB-203 (Won't Fix). IPTV providers commonly serve plain
        HTTP; the host-set is user-configured at runtime, so a static
        network_security_config.xml allow-list isn't workable (Android
        reads that XML once at Application.onCreate and offers no
        runtime mutation API). Provider credentials are already in the
        URLs (Xtream auth is ?username=…&password=…); cleartext doesn't
        make that worse. Sentry telemetry is HTTPS-only by SDK config;
        Coil CDN images are HTTPS by convention. Defense-in-depth at
        the OkHttp layer is tracked as MK.SEC.* future work; this
        manifest setting will not change.

        The yancoxplorer mobile-readiness scanner reports this as HIGH on
        every audit; the finding is recorded as accepted-risk in
        docs/security/AUDIT_NOTES.md.
    -->
    <application
        android:name=".YancoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.YancoTV"
        android:usesCleartextTraffic="true">

        <!-- Stage 1.3 — disable Sentry's auto-init ContentProvider. We init
             manually in YancoApp.onCreate via SentryInit.install(this) so the
             DSN can be sourced from local.properties (gitignored, per-machine)
             instead of being baked into the manifest. The auto-init provider
             would otherwise crash with "DSN is required" on launch. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!-- MainActivity is the LAUNCHER/LEANBACK_LAUNCHER entry point and
             also responds to ACTION_SEARCH from Google Assistant / Fire TV
             voice. Both require android:exported="true" — there is no way
             to expose a launcher activity without it. Semgrep's
             exported_activity rule fires on every such declaration as a
             review tripwire; the privilege boundary is intentional. -->
        <!-- nosemgrep: java.android.security.exported_activity.exported_activity -->
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:logo="@drawable/tv_banner"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateHidden|adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- MK.10.3 — voice search deep link. Google Assistant / Fire
                 TV voice remote (and any Android-TV launcher's "Search this
                 app" affordance) dispatches ACTION_SEARCH with the
                 recognised query in `SearchManager.QUERY`. Paired with
                 res/xml/searchable.xml metadata so the searchable surface
                 is discoverable to the system. -->
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
        </activity>

        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/PlayerTheme"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode|smallestScreenSize" />

        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- MK.14.3 — fires when a scheduled recording's pre-fire or end
             alarm triggers. Pre-fire: decides tee / switch+tee / missed
             based on player state, then starts RecordingService. End:
             stops the linked recording and transitions the schedule to
             COMPLETED. -->
        <receiver
            android:name=".recording.schedule.RecordingScheduleReceiver"
            android:exported="false" />

        <!-- MK.14.3 — re-arms alarms that didn't survive reboot, plus
             reconciles lapsed schedules to MISSED so the UI doesn't
             show stale "scheduled" entries forever. -->
        <receiver
            android:name=".recording.schedule.RecordingScheduleBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Stage 3.1 / MK.14.1e — foreground service that owns every
             in-flight recording. `dataSync` is the appropriate type
             (we're streaming bytes from the network and writing them
             to a file; not media playback / not user-visible camera). -->
        <service
            android:name=".recording.RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Stage 5.2.3 — FileProvider exposes the downloaded APK to the
             system PackageInstaller via a content:// URI (file:// is
             rejected on Android 7+ with FileUriExposedException). Scoped
             to "updates/" under getExternalFilesDir(null); see
             res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
