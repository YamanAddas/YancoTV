.gradle/
build/
# Per-machine secrets (Sentry DSN + auth token, keystore credentials,
# update endpoint). `local.properties*` also covers timestamped backups
# created by scripts/setup-sentry-env.ps1 during Sentry rotation —
# those backups carry the old (revoked) credentials in patterns
# secret-scanners still match, so they must not get committed or sit
# inside the project tree where filesystem-walking scanners find them.
local.properties*
.idea/
*.iml
captures/
.cxx/

# Stage 5.2.3 — locally staged auto-update test artifacts (APK + update.json)
/auto-update-test/

# Local installer/helper downloads used during Android TV testing.
*.exe


# MB-201 — release signing keystore (out-of-tree, never committed).
/release.keystore
