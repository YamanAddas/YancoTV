{
  "name": "@yancotv/core",
  "version": "0.1.0",
  "description": "Shared business logic for YancoTV (parsers, types, schemas, Xtream/Stalker clients). Platform-agnostic.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "react-native": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "source": "./src/types/index.ts",
      "react-native": "./src/types/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./schemas": {
      "source": "./src/schemas/index.ts",
      "react-native": "./src/schemas/index.ts",
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    },
    "./parsers": {
      "source": "./src/parsers/index.ts",
      "react-native": "./src/parsers/index.ts",
      "types": "./dist/parsers/index.d.ts",
      "default": "./dist/parsers/index.js"
    },
    "./content": {
      "source": "./src/content/index.ts",
      "react-native": "./src/content/index.ts",
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./catchup": {
      "source": "./src/catchup/index.ts",
      "react-native": "./src/catchup/index.ts",
      "types": "./dist/catchup/index.d.ts",
      "default": "./dist/catchup/index.js"
    },
    "./parental": {
      "source": "./src/parental/index.ts",
      "react-native": "./src/parental/index.ts",
      "types": "./dist/parental/index.d.ts",
      "default": "./dist/parental/index.js"
    },
    "./stores": {
      "source": "./src/stores/index.ts",
      "react-native": "./src/stores/index.ts",
      "types": "./dist/stores/index.d.ts",
      "default": "./dist/stores/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "pako": "^2.1.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/pako": "^2.0.4",
    "typescript": "^5.7.3"
  }
}
