# Security hardening for pnpm
# Enforce exact lockfile in CI — prevents supply chain drift
frozen-lockfile=true

# Strict peer dependencies — fail on mismatches instead of silently ignoring
strict-peer-dependencies=true

# Only allow pnpm as the package manager (enforced via preinstall script too)
engine-strict=true

# Do not run arbitrary lifecycle scripts from dependencies by default
# (pnpm.onlyBuiltDependencies in package.json controls which packages can build)
ignore-scripts=false
