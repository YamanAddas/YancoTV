node_modules/
dist/
release/
*.db
*.db-wal
*.db-shm
.env
.env.local
*.log
# Commit shared Claude Code config (skills, agents, project-shared settings);
# ignore only personal/generated files. Skills encode non-negotiable project
# rules (see .claude/skills/native-android-mk/) and must survive a fresh clone.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/launch.json
# Per-session agent scratch — DB dumps, logcat tails, .ts test recordings,
# spawned worktree state. Local debugging artifacts only.
.claude/worktrees/
CLAUDE.local.md
mpv/
playwright-report/
test-results/
# Electron user-data dir the E2E helper points the app at
.test-user-data/

# Mobile APK outputs
dist-apk/
packages/mobile/android/app/build/
packages/mobile/android/build/
packages/mobile/android/.gradle/

# Local working files (secrets, scratch)
dont commit.txt
/yancotv_logo.png
.claude-scratch/
# Keystore-backup helper: contains release.keystore + Sentry secrets in
# plaintext. Generated on demand to transit the values into a password
# manager, then deleted. Never commit.
/RELEASE_BACKUP.txt
# Scratch dir for the public yancotv-releases repo's starter files.
# Lives inside this private repo for convenience; gets copied OUT into
# the new public repo's clone when the user is ready to push.
/_release_repo_scaffold/

# adb logcat dumps + ad-hoc screenshots kept out of the tree — these
# appear next to the repo root during debugging sessions and aren't
# meant to be committed.
tvdump*.txt
tv-screen*.png
tmp_screen*.png
# Catches the accidentally-created `D:YancoTVtvdump.txt` style filenames
# (Windows path typed as a filename instead of a redirect target).
D:YancoTV*.txt

# pnpm patch editable copies (the generated patch in patches/ is committed)
patches-work/

# Concept A design zip — local reference only
packages/android/*.zip

# Yancoxplorer launch-audit reports — dropped at repo root by the
# scanner each run. Diff against docs/security/AUDIT_NOTES.md
# fingerprints; the JSONs themselves are scan artifacts, not source.
/yancoxplorer-audit-*.json

# TypeScript type-coverage report directory (auto-regenerated)
/.type-coverage/

# Firecrawl scrape cache — web content pulled during research sessions.
# Tooling output, not source.
/.firecrawl/

# Exported app backups (`yancotv-backup-<timestamp>.json`). These are the
# user's own data written by Settings -> Backup, and an UNENCRYPTED export
# carries provider credentials in plain text. Never commit them.
/backups/

# Android SDK location — per-machine, never committed. The packages/android
# one (keystore password, Sentry DSN) is ignored by its own .gitignore.
/local.properties
